          "attribute": "country",
          "operator": "EQUALS",
          "value": "US"
        }
      ]
    },
    "userId": "ravi",
    "attributes": {
      "country": "IN",
      "plan": "pro"
    },
    "expected": {
      "enabled": false,
      "reason": "FLAG_DISABLED"
    }
  },
