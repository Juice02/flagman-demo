    "userId": "ravi",
    "attributes": {
      "country": "IN",
      "plan": "pro"
    },
    "expected": {
      "enabled": false,
      "reason": "FLAG_DISABLED"
    }
  },
  {
    "name": "disabled wins over failing rules",
